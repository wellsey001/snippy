{
  "name": "snippy",
  "version": "0.44.0",
  "description": "A free, playful desktop video editor",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis-web",
    "dist:offline": "electron-builder --win nsis",
    "release": "electron-builder --win nsis-web --publish always",
    "update": "node update.js"
  },
  "build": {
    "appId": "com.snippy.editor",
    "productName": "Snippy",
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "nsis-web",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "fileAssociations": [
      {
        "ext": "snippy",
        "name": "Snippy project",
        "icon": "build/icon.ico"
      },
      {
        "ext": "cutline",
        "name": "Snippy project",
        "icon": "build/icon.ico"
      }
    ],
    "files": [
      "**/*",
      "!node_modules/ffmpeg-static/**",
      "!node_modules/ffprobe-static/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/win32/arm64/**",
      "!docs/**",
      "!components/**",
      "!build-exclude.json",
      "!node_modules/onnxruntime-web/**",
      "!scripts/**",
      "!.github/**",
      "!update.js",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "nsisWeb": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Snippy-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wellsey001",
        "repo": "snippy",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-GB",
      "en-US"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "@huggingface/transformers": "^3.2.0",
    "electron-updater": "^6.3.9",
    "kokoro-js": "^1.2.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wellsey001/snippy.git"
  }
}
